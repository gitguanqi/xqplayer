{
  "name": "xqplayer",
  "version": "0.2.0",
  "description": "A simple, friendly HTML5 video player (UMD + ESM + Vue 2/3) with HLS/FLV and bullet-screen support.",
  "main": "lib/js/xqplayer.js",
  "module": "lib/js/xqplayer-esm.mjs",
  "browser": "lib/js/xqplayer.js",
  "unpkg": "lib/js/xqplayer.min.js",
  "jsdelivr": "lib/js/xqplayer.min.js",
  "types": "types/index.d.ts",
  "llms": "./llms.txt",
  "agents": "./skills/xqplayer-integration/SKILL.md",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/js/xqplayer-esm.mjs",
      "require": "./lib/js/xqplayer.js",
      "default": "./lib/js/xqplayer.js"
    },
    "./vue": {
      "types": "./lib/vue/index.d.ts",
      "import": "./lib/vue/index.js",
      "default": "./lib/vue/index.js"
    },
    "./css/xqplayer.css": "./lib/css/xqplayer.css",
    "./css/xqplayer.min.css": "./lib/css/xqplayer.min.css",
    "./css/xqplayer-icon.css": "./lib/css/xqplayer-icon.css",
    "./fonts/*": "./lib/fonts/*",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/js",
    "lib/css",
    "lib/fonts",
    "lib/vue",
    "types",
    "llms.txt",
    "skills",
    "README.md",
    "zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "./lib/vue/*"
  ],
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "pretest": "npm run check",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:harness": "node scripts/dom-harness.mjs --all",
    "serve": "node scripts/serve.mjs",
    "test:browser": "node scripts/serve.mjs",
    "prepublishOnly": "npm run build && npm test",
    "release": "node scripts/release.mjs",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitguanqi/xqplayer.git"
  },
  "keywords": [
    "player",
    "video",
    "video-player",
    "hls",
    "flv",
    "barrage",
    "xqplayer"
  ],
  "author": "gitguanqi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gitguanqi/xqplayer/issues"
  },
  "homepage": "https://github.com/gitguanqi/xqplayer#readme",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  },
  "dependencies": {
    "xqshare": "^0.1.2"
  }
}
